# Local development template only. Copy to .env and fill with isolated test credentials.
# Never commit .env, production credentials, or a private signing key.
MONGODB_URI=mongodb://127.0.0.1:27018/LicenseHubDb?directConnection=true
LICENSE_DATABASE=LicenseHubDb
LICENSE_SIGNING_PRIVATE_KEY_PATH=/absolute/path/to/license-private.pem
LICENSE_KEY_PEPPER=replace-with-base64-encoded-random-32-byte-value
LICENSE_ADMIN_TOKEN=replace-with-random-secret-at-least-32-bytes
ASPNETCORE_URLS=http://127.0.0.1:8080

# Desktop client configuration; the public key is safe to distribute with the app.
CLINIC_ORCHESTRATOR_LICENSE_HUB_URL=https://license.example.invalid
CLINIC_ORCHESTRATOR_LICENSE_PUBLIC_KEY_FILE=/absolute/path/to/license-public.pem
CLINIC_ORCHESTRATOR_LICENSE_REQUIRED=true
