LICENSE_HUB_IMAGE=jtuongdev/agentforge-admin:0.1.0-admin.1
LICENSE_HUB_BIND_ADDRESS=127.0.0.1
LICENSE_HUB_PORT=8080
MONGODB_URI=mongodb+srv://replace-user:replace-password@replace-host/
LICENSE_DATABASE=LicenseHubDb
LICENSE_KEY_PEPPER=replace-with-base64-random-at-least-32-bytes
LICENSE_ADMIN_TOKEN=replace-with-random-secret-at-least-32-characters
# Absolute path on the deployment server; file must be readable by UID 1654.
LICENSE_SIGNING_PRIVATE_KEY_PATH=/opt/agentforge/secrets/license-private.pem
