{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevAgent Orchestrator",
  "version": "0.1.0",
  "identifier": "com.jtuongdang.devagent-orchestrator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run desktop:build"
  },
  "app": {
    "windows": [
      {
        "title": "DevAgent Orchestrator",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; script-src 'self' 'unsafe-inline' tauri: asset:; connect-src ipc: http://ipc.localhost tauri: http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/devagent-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
